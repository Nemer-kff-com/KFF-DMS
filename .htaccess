# DMS — Apache security (portable: any LAN host + public hosting)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS only on public domains (never on localhost / LAN IP / short PC names)
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
RewriteCond %{HTTP_HOST} !^10\. [NC]
RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\. [NC]
RewriteCond %{HTTP_HOST} !\.local(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !\.lan(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^[a-z0-9-]+(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block installer on public hosts only
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
RewriteCond %{HTTP_HOST} !^10\. [NC]
RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\. [NC]
RewriteCond %{HTTP_HOST} !\.local(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !\.lan(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^[a-z0-9-]+(:\d+)?$ [NC]
RewriteRule ^install(/|$) - [F,L]
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
RewriteCond %{HTTP_HOST} !^10\. [NC]
RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\. [NC]
RewriteCond %{HTTP_HOST} !\.local(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !\.lan(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^[a-z0-9-]+(:\d+)?$ [NC]
RewriteRule ^install\.php$ - [F,L]

# Block sensitive directories from direct web access
RewriteRule ^(config|sql|Docs|doc|var|logs|includes|lang|sessions|Backup|backup|storage|tools|lib|\.cursor|\.git|\.vs)(/|$) - [F,L]

# Block include-only PHP partials (_form.php, _form_fields.php, …)
RewriteRule (^|/)_[^/]+\.php$ - [F,L]

# Block sensitive file extensions
RewriteRule \.(sql|bak|backup|log|ini|env|md|yml|yaml|lock|dist)$ - [F,L,NC]
RewriteRule (^|/)error_log$ - [F,L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|bak|ini|env|lock|yml|yaml|md)$">
    Require all denied
</FilesMatch>

<Files "error_log">
    Require all denied
</Files>

<Files "composer.json">
    Require all denied
</Files>

<Files "composer.lock">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
